# Corpus and derived splits are large and are public data. They are fetched by
# scripts/fetch_corpus.py rather than committed, so a clean clone reproduces them.
data/raw/
data/split/
data/index/

# Secrets. Nothing in this repo may carry a credential: it ships public under an
# OSI license as a submission requirement.
.env
.env.*
*.pem
config.local.json
credentials.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node
node_modules/
.next/
dist/

# Local scratch
scratch/
*.log

# Demo video working files. The narration recording and captured clips are large
# and belong on the video host, not in the repo.
broll/
*.mp4
*.mov
*.wav
*.m4a
